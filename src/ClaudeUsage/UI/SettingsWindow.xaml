<Window x:Class="ClaudeUsage.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude usage settings"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="#FF1F1F23"
        BorderBrush="#FF3A3A42"
        BorderThickness="1"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">
    <!-- No title bar: the header row is the caption (drag to move). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="0,3,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="Background" Value="{StaticResource Track}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
                <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
                <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Height" Value="26" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="1"
                                    BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="6" Padding="6,0">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Flat checkbox: rounded box that fills with the accent when checked. -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1"
                                        Background="{StaticResource Track}" BorderBrush="{StaticResource PanelBorder}"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{StaticResource Panel}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ChipButton}">
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="Background" Value="{StaticResource AccentWash}" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="MinWidth" Value="72" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="16,6,12,14">
        <DockPanel Height="34" LastChildFill="True">
            <Button DockPanel.Dock="Right" Style="{StaticResource HeaderButton}" Content="&#xE711;" ToolTip="Close"
                    VerticalAlignment="Center" Click="OnCancelClick" />
            <TextBlock Text="Settings" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel Margin="0,0,4,0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Claude CLI" Margin="0,4,0,4" />
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Margin="6,0,0,0" Content="Browse…"
                        Click="OnBrowseClaudeClick" />
                <TextBox x:Name="ClaudePathBox" />
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Path to claude.exe or claude.cmd. Leave blank to look on PATH, in ~\.local\bin and %APPDATA%\npm." />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Projects folder" />
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Margin="6,0,0,0" Content="Browse…"
                        Click="OnBrowseRootClick" />
                <TextBox x:Name="ProjectsRootBox" />
            </DockPanel>
            <TextBlock x:Name="ProjectsRootHint" Style="{StaticResource Hint}" />

            <CheckBox x:Name="TopmostBox" Content="Keep the widget on top of other windows" Margin="0,16,0,0" />
            <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows (in the tray)" />

            <TextBlock x:Name="ErrorText" Margin="0,14,0,0" FontSize="11.5" Foreground="{StaticResource ErrorText}"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <DockPanel Margin="0,18,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Save" IsDefault="True"
                        Click="OnSaveClick" />
                <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Content="Cancel" Margin="0"
                        Click="OnCancelClick" />
            </DockPanel>
        </StackPanel>
    </StackPanel>
</Window>
